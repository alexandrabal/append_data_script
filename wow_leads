
 CREATE OR REPLACE
 view wow_leads as
with weekly as (
    select
        go.week
        ,go.channel
        ,gs.spend
        ,count(go.company_id) as leads
         ,avg(time_until_verification) as avg_time_to_verified
        ,SUM(case when go.verified = 'Yes' then 1 else 0 end) as mqls
        ,SUM(case when go.lead_priority = 'High Priority' then 1 else 0 end) as high_priority_leads
        ,SUM(case when go.lead_priority = 'Medium Priority' then 1 else 0 end) as medium_priority_leads
        ,SUM(case when go.lead_priority = 'Low Priority' then 1 else 0 end) as low_priority_leads
    from growth_operations go
    left join growth_spend_clensed_data gs
        on  go.channel = gs.channel
        and go.week    = gs.week
    group by
        go.week
        ,go.channel
        ,gs.spend
)
select
    week
    ,channel
    ,spend
    ,leads
    ,mqls
   ,high_priority_leads
   ,medium_priority_leads
   ,low_priority_leads
   ,avg_time_to_verified
    ,lag(leads) over (partition by channel order by week) as prev_week_leads
    ,leads - lag(leads) over (partition by channel order by week) as wow_change
    ,round(
        100.0 * (leads - lag(leads) over (partition by channel order by week))
        / nullif(lag(leads) over (partition by channel order by week), 0)
    , 1) as wow_pct_change
from weekly
order by week asc, channel;
